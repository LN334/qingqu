<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QingquKiosk</AssemblyName>
    <RootNamespace>ZhifuWater.Kiosk</RootNamespace>
    <ApplicationIcon>..\..\desktop\build\icon.ico</ApplicationIcon>
    <Version>2.0.7</Version>
    <Company>LN334</Company>
    <Product>清渠 · 现场触摸屏</Product>
    <AssemblyTitle>清渠 · 现场触摸屏</AssemblyTitle>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZhifuWater.Desktop\ZhifuWater.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 现场机器首次启动的数据快照（Core 会复制到 %LOCALAPPDATA%\ZhifuWater）。 -->
    <Content Include="..\seed\db.json" Link="seed\db.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
