<Window x:Class="ZhifuWater.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清渠 · 村镇水处理站智能运维平台"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧导航 ========== -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="14,13,12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="{DynamicResource Accent}" CornerRadius="2">
                                <TextBlock Text="清" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="清渠" Foreground="#F2F7F8" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="村镇水处理站智能运维平台" Foreground="#7E939D" FontSize="9.5" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#1E2B33" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="12,7,12,9">
                    <StackPanel>
                        <TextBlock x:Name="SidebarSource" FontSize="9.5" Foreground="#7E939D" TextWrapping="Wrap" />
                        <TextBlock Text="v2.0.3" FontSize="9.5" Foreground="#5D727B" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="0,4,0,8" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========== 右侧主区 ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" Text="综合驾驶舱" />
                        <TextBlock x:Name="PageCrumb" FontSize="10.5" Foreground="{DynamicResource Muted2}"
                                   Margin="0,1,0,0" Text="总览 / 综合驾驶舱" />
                    </StackPanel>

                    <ComboBox x:Name="SiteCombo" Grid.Column="1" Width="186" Height="27" Margin="10,0,0,0"
                              VerticalAlignment="Center" ToolTip="切换站点" DisplayMemberPath="Name"
                              SelectionChanged="OnSiteChanged" />

                    <TextBlock x:Name="ClockText" Grid.Column="2" FontFamily="{DynamicResource MonoFont}"
                               FontSize="12" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"
                               Margin="14,0,4,0" Text="--:--:--" />

                    <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Width="52" Height="27"
                            Style="{DynamicResource BaseButton}" VerticalAlignment="Center"
                            ToolTip="立即刷新（平时每 5 秒自动刷新）" Click="OnRefreshClick" />

                    <Button x:Name="BellButton" Grid.Column="4" Height="27" Margin="8,0,0,0"
                            Style="{DynamicResource BaseButton}" VerticalAlignment="Center"
                            ToolTip="通知与未读消息" Click="OnBellClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="通知" />
                            <Border x:Name="BellBadge" Background="#B23A2E" CornerRadius="7" Height="14"
                                    MinWidth="14" Padding="4,0" Margin="5,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="BellBadgeText" Text="0" FontSize="9" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UserButton" Grid.Column="5" Height="27" Margin="8,0,0,0"
                            Style="{DynamicResource BaseButton}" VerticalAlignment="Center"
                            Click="OnUserClick" ToolTip="用户菜单">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UserNameText" Text="用户" />
                            <TextBlock Text="  ▾" FontSize="10" Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="PageHost" />

            <Border Grid.Row="2" Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0,12,0">
                    <TextBlock x:Name="FooterSource" FontSize="10" Foreground="{DynamicResource Muted2}"
                               VerticalAlignment="Center" Text="数据来源：本地演示引擎" />
                    <TextBlock x:Name="FooterRight" FontSize="10" Foreground="{DynamicResource Muted2}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Text="最后更新 —" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 通知弹层 ========== -->
        <Popup x:Name="BellPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-250">
            <Border Style="{DynamicResource MenuBorder}" Width="372">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="通知中心" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                            <Button Content="全部标为已读" Style="{DynamicResource LinkButton}" HorizontalAlignment="Right"
                                    Click="OnMarkReadClick" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BellList" Margin="6" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ========== 用户菜单 ========== -->
        <Popup x:Name="UserPopup" PlacementTarget="{Binding ElementName=UserButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{DynamicResource MenuBorder}" Width="212">
                <StackPanel Margin="10,8">
                    <TextBlock x:Name="MenuName" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock x:Name="MenuRole" FontSize="10.5" Foreground="{DynamicResource Muted2}"
                               Margin="0,2,0,0" />
                    <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,8" />
                    <Button Content="修改密码" Style="{DynamicResource MenuButton}" Click="OnChangePasswordClick" />
                    <Button Content="退出登录" Style="{DynamicResource MenuButton}" Click="OnLogoutClick" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ========== 轻提示 ========== -->
        <Border x:Name="ToastPanel" Visibility="Collapsed" Background="#1E2A31" CornerRadius="3"
                Padding="13,8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,32" IsHitTestVisible="False" Panel.ZIndex="90">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="420" />
        </Border>
    </Grid>
</Window>
