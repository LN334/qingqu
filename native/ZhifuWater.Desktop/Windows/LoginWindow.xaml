<Window x:Class="ZhifuWater.Desktop.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清渠"
        Width="1080" Height="720"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource Ink2}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <!-- 品牌侧 -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Image Source="pack://application:,,,/Assets/site-plant.jpg" Stretch="UniformToFill" Opacity="0.9" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B806252A" Offset="0" />
                        <GradientStop Color="#D90A3638" Offset="0.55" />
                        <GradientStop Color="#F00D4743" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A6000000" Offset="0" />
                        <GradientStop Color="#33000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Canvas IsHitTestVisible="False">
                <Ellipse Width="760" Height="760" Stroke="#12FFFFFF" StrokeThickness="1"
                         Canvas.Left="-280" Canvas.Top="-300" />
                <Ellipse Width="980" Height="980" Stroke="#0DFFFFFF" StrokeThickness="1"
                         Canvas.Left="-380" Canvas.Top="-410" />
                <Path Data="M0,596 C170,556 300,636 470,596 C640,556 770,636 940,596"
                      Stroke="#22FFFFFF" StrokeThickness="1" />
                <Path Data="M0,636 C170,596 300,676 470,636 C640,596 770,676 940,636"
                      Stroke="#14FFFFFF" StrokeThickness="1" />
            </Canvas>

            <StackPanel Margin="64,0,48,0" VerticalAlignment="Center">
                <Grid Width="46" Height="50" HorizontalAlignment="Left">
                    <Path Data="M23,3 C23,3 39,21 39,31 A16,16 0 0 1 7,31 C7,21 23,3 23,3 Z"
                          Fill="#1EFFFFFF" Stroke="#D9F2EE" StrokeThickness="1.3" Stretch="Fill" />
                    <Path Data="M23,31 C20,27 20,23 23,20 C26,23 26,27 23,31 Z"
                          Fill="#7ED9CB" Stretch="Fill" Margin="17,17,17,15" />
                </Grid>

                <TextBlock Text="清渠" FontSize="30" FontWeight="SemiBold" Foreground="#F4FBFA"
                           Margin="0,20,0,0" />
                <TextBlock Text="QINGQU" FontSize="11" Foreground="#7FC0B6" Margin="1,5,0,0" />

                <Border Width="34" Height="2" Background="#5EBCAE" HorizontalAlignment="Left"
                        Margin="0,26,0,0" />
                <TextBlock Text="村镇水处理站智能运维平台" FontSize="13" Foreground="#C3DDD8"
                           Margin="0,14,0,0" />
            </StackPanel>

        </Grid>

        <!-- 登录表单 -->
        <Grid Grid.Column="1" Background="#FFFFFF">
            <Path Data="M23,3 C23,3 39,21 39,31 A16,16 0 0 1 7,31 C7,21 23,3 23,3 Z"
                  Stroke="#0F0E7C74" StrokeThickness="2" Stretch="Fill"
                  Width="300" Height="330" Opacity="0.5"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-70"
                  IsHitTestVisible="False" />

            <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="30" Height="2" Background="#0E7C74" HorizontalAlignment="Left" />
                <TextBlock Text="登录" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           Margin="0,14,0,0" />

                <TextBlock Text="账号" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,30,0,0" />
                <Grid Margin="0,6,0,18">
                    <TextBox x:Name="AccountBox" Height="36" FontSize="13"
                             VerticalContentAlignment="Center" MaxLength="32" />
                    <TextBlock x:Name="AccountHint" Text="请输入账号" FontSize="13"
                               Foreground="{DynamicResource Muted2}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <TextBlock Text="密码" FontSize="12" Foreground="{DynamicResource Muted}" />
                <Grid Margin="0,6,0,4">
                    <PasswordBox x:Name="PasswordBox" Height="36" FontSize="13"
                                 VerticalContentAlignment="Center" MaxLength="32" />
                    <TextBlock x:Name="PasswordHint" Text="请输入密码" FontSize="13"
                               Foreground="{DynamicResource Muted2}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource Bad}"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />

                <Button x:Name="LoginButton" Content="登录" Height="38" Margin="0,22,0,0"
                        Style="{DynamicResource PrimaryButton}" Foreground="#FFFFFFFF" Background="#FF0E7C74" IsDefault="True" Click="OnLoginClick" />
            </StackPanel>

            <TextBlock Text="v2.0.9" FontSize="11" Foreground="{DynamicResource Muted2}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,16" />
        </Grid>
    </Grid>
</Window>
